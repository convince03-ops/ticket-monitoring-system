generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  role          Role            @default(REQUESTOR)
  additionalRoles Role[]         @default([])
  department    Department?     @relation(fields: [departmentId], references: [id])
  departmentId  String?
  tickets       Ticket[]        @relation("TicketRequestor")
  assigned      Ticket[]        @relation("TicketDesigner")
  activityLogs  ActivityLog[]
  holidays      Holiday[]
  notifications Notification[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum Role {
  ADMINISTRATOR
  TECHNICIAN
  DESIGNER
  REQUESTOR
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Material {
  id          String    @id @default(cuid())
  name        String    @unique
  slaDays     Int
  status      Status    @default(ACTIVE)
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Status {
  ACTIVE
  INACTIVE
}

model Ticket {
  id                   String        @id @default(cuid())
  ticketNumber         String        @unique
  description          String
  requestor            User          @relation("TicketRequestor", fields: [requestorId], references: [id])
  requestorId          String
  department           Department    @relation(fields: [departmentId], references: [id])
  departmentId         String
  material             Material      @relation(fields: [materialId], references: [id])
  materialId           String
  type                 TicketType
  designer             User?         @relation("TicketDesigner", fields: [designerId], references: [id])
  designerId           String?
  dateReceivedByArtist DateTime
  workingDays          Int
  deadline             DateTime
  ticketLevel          TicketLevel
  status               TicketStatus  @default(OPEN)
  remarks              String?
  attachments          Attachment[]
  activityLogs         ActivityLog[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

enum TicketType {
  PROMO
  FLYERS
  STATIC_LAYOUT
  MOTION_GRAPHICS
  VIDEO_AVP
  DIGITAL_COLLATS
  VM_REQUESTS
  ISM_GRAPHICS
}

enum TicketLevel {
  MINOR
  MODERATE
  MAJOR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Attachment {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String
  fileName  String
  url       String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  details   String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId  String?
  createdAt DateTime @default(now())
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @unique
  createdBy  User?   @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}
