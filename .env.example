# Supabase Database
# Get this from: Supabase Dashboard > Project Settings > Database
DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[database]?schema=public"

# Supabase API
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-id].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[your-anon-key]"
SUPABASE_SECRET_KEY="[server-only service role key; never expose to the browser]"

# Groq Requestor Assistant
# Keep both keys server-side; the fallback is tried if the primary request fails.
GROQ_API_KEY="[primary Groq API key]"
GROQ_API_KEY_FALLBACK="[fallback Groq API key]"
GROQ_MODEL="llama-3.3-70b-versatile"

# NextAuth Configuration
# NEXTAUTH_URL should match your deployment URL
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[generate-with-openssl-rand-base64-32]"

# Microsoft Entra ID (Azure AD)
# Get these from: Azure Portal > App Registrations > Your App > Overview & Certificates & secrets
AZURE_AD_CLIENT_ID="[your-client-id]"
AZURE_AD_CLIENT_SECRET="[your-client-secret]"
AZURE_AD_TENANT_ID="[your-tenant-id]"

# File Upload (Optional - for attachments)
# Configure if using Supabase Storage for file uploads
NEXT_PUBLIC_STORAGE_URL="https://[project-id].supabase.co/storage/v1/object/public/attachments"
